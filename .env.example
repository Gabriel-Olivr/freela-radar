# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub.

# WhatsApp via CallMeBot (grátis, só para mandar mensagem para você mesmo)
CALLMEBOT_PHONE=+5581999999999
CALLMEBOT_APIKEY=1234567

# Endereço do seu painel no GitHub Pages (vai no fim de cada mensagem)
PAINEL_URL=https://gabriel-olivr.github.io/freela-radar/

# Seu usuário do Reddit (só identifica o robô no pedido ao Reddit)
REDDIT_USUARIO=seu_usuario

# Opcional: Telegram também (deixe vazio para não usar)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
